# Copy to docker/.env (gitignored) and adjust. All machine-specific values live here.
# The host's working tree (main checkout): data/ (with the host kit's bridge key in data/bridge/), local-only files. It is also the host
# path of the repo the container tells sessions about (the code itself runs from /app in the image).
AFCLAUDE_HOST_REPO=/mnt/BlockVolume/Claude/work/AFClaude
HOST_HOME=/home/opc
# SSH bridge: user and host (host-gateway = docker0 address; sshd must listen there).
AFCLAUDE_BRIDGE_USER=opc
AFCLAUDE_BRIDGE_HOST=host.docker.internal
# Must lie inside the host kit's authorized_keys from= (install_host_bridge.sh --from, default 172.28.0.0/24).
AFCLAUDE_SUBNET=172.28.0.0/24
# runner = the container runs its schedule with the resident runner (phase 3a S8); off = idle (tests, MCP
# server only). The task-managers' sessions come from the DB (projects.manager_session, phase 3b), not from here.
AFCLAUDE_SCHEDULER=off
# single (default, the one container of compose.yml) | services (the three services of compose.services.yml; K7 flips
# this together with AFCLAUDE_DATA, see docs/phase5b_plan.md K4). tools/deploy.py reads it from here.
#AFCLAUDE_LAYOUT=single
