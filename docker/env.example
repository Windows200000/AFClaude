# Copy to docker/.env (gitignored) and adjust. All machine-specific values live here.
# Code path inside the image; must equal the host repo path (host-facing cwd / paths).
AFCLAUDE_DIR=/mnt/BlockVolume/Claude/work/AFClaude
# The host's working tree (main checkout): data/, local-only files, the bridge key.
AFCLAUDE_HOST_REPO=/mnt/BlockVolume/Claude/work/AFClaude
HOST_HOME=/home/opc
# SSH bridge: user and host (host-gateway = docker0 address; sshd must listen there).
AFCLAUDE_BRIDGE_USER=opc
AFCLAUDE_BRIDGE_HOST=host.docker.internal
# The AFClaude manager session (kept alive by the watcher and the window-start cron).
AFCLAUDE_MANAGER_SESSION=00000000-0000-0000-0000-000000000000
# Must lie inside 172.16.0.0/12 (the authorized_keys from= of the bridge key).
AFCLAUDE_SUBNET=172.28.0.0/24
# on = the container runs the schedule; off = idle (tests, MCP server only).
AFCLAUDE_SCHEDULER=off
