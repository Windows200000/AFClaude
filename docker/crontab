# AFClaude manager container crontab (supercronic, container clock = UTC like the host).
# Mirrors the host's AFClaude crontab lines; every Claude-side action goes through the
# SSH bridge (host.py). Keep the "# AFClaude ..." tags: export_quickview.py lists them.
*/15 * * * * flock -n $AFCLAUDE_DIR/data/.sampler.lock python3 $AFCLAUDE_DIR/usage_sampler.py >> $AFCLAUDE_DIR/data/sampler.log 2>&1 # AFClaude usage sampler
# WINDOW-START: keep this schedule identical to the host crontab's "AFClaude window-start" line
# (it follows the window start in keepalive.py; cron runs it at both possible UTC hours, and
# keepalive.py --window-start only acts in the Berlin start hour). Update both together.
0 21,22 * * * cd $AFCLAUDE_DIR && python3 keepalive.py --session $AFCLAUDE_MANAGER_SESSION --window-start --arm --take-over-idle >> $KEEPALIVE_STATE_DIR/keepalive.log 2>&1 # AFClaude window-start
7,22,37,52 * * * * [ -e $AFCLAUDE_DIR/PAUSED ] || $AFCLAUDE_DIR/docker/start_watcher.sh >/dev/null 2>>$KEEPALIVE_STATE_DIR/watchdog.log # AFClaude watcher watchdog (no-op if running)
0 * * * * cd $AFCLAUDE_DIR && python3 usage_review.py >> $KEEPALIVE_STATE_DIR/keepalive.log 2>&1 # AFClaude usage-model review (runs when data/usage_review_state.json next_run_at has passed)
*/3 * * * * flock -n $AFCLAUDE_DIR/data/.quickview.lock python3 $AFCLAUDE_DIR/export_quickview.py >> $AFCLAUDE_DIR/data/quickview_export.log 2>&1 # AFClaude quickview export
*/10 * * * * cd $AFCLAUDE_DIR && python3 dispatcher.py --arm --once >> $AFCLAUDE_DIR/data/dispatcher.log 2>&1 # AFClaude dispatcher (acts only inside the 23:00-09:00 Berlin window or the last mile)
* * * * * python3 $AFCLAUDE_DIR/docker/at_shim.py --run-due >> $AFCLAUDE_DIR/data/at_shim.log 2>&1 # AFClaude at-shim (the sampler's pre/post weekly-reset samples)
