     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "error (the one error shape, §8)"
     }
    },
    "summary": "This API's OpenAPI 3.1 document.",
    "x-access": "session"
   }
  }
 }
