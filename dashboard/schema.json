        "schema": {
         "$ref": "#/components/schemas/HealthResponse"
        }
       }
      },
      "description": "Is the backend usable (the database writable and intact)? 503 when not."
     },
     "503": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthResponse"
        }
       }
      },
      "description": "Is the backend usable (the database writable and intact)? 503 when not."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "error (the one error shape, §8)"
     }
    },
    "summary": "Is the backend usable (the database writable and intact)? 503 when not.",
    "x-access": "public"
   }
  },
