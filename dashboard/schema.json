     }
    },
    "required": [
     "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
   },
   "HealthResponse": {
    "additionalProperties": false,
    "description": "GET /api/v1/health (public, no secrets): `db` is \"ok\" or the kind of the database problem\n(store.health(): missing, read_only, disk_full, corrupt, schema_too_new, ...).",
    "properties": {
     "db": {
      "title": "Db",
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "unavailable"
      ],
