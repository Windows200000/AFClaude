{
  "enabledPlugins": {
    "commercial-legal@synced": false,
    "product-legal@synced": false,
    "regulatory-legal@synced": false,
    "legal-builder-hub@synced": false
  },
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(bash tools/test_compact_live.sh:*)",
      "Bash(python3 tasks.py:*)",
      "Bash(python3 keepalive.py --decide:*)",
      "Bash(python3 keepalive.py --run-stopped:*)",
      "Bash(python3 usage_report.py:*)",
      "Bash(claude agents:*)",
      "mcp__afclaude",
      "Bash(python3 tools/deploy.py)",
      "Bash(python3 tools/deploy.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/keepalive.py\" --session-rules manager",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/keepalive.py\" --session-rules afclaude",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/decisions.py\" hook --part 1 --of 3",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/decisions.py\" hook --part 2 --of 3",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/decisions.py\" hook --part 3 --of 3",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "idleCompaction": false
}
